{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings --experimental-transform-types tools/agent-hooks/claude-codex.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
