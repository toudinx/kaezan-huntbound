{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node --no-warnings --experimental-transform-types tools/agent-hooks/cursor.ts",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "node --no-warnings --experimental-transform-types tools/agent-hooks/cursor.ts",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
